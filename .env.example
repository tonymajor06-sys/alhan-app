# Copy to .env.local (ignored by git) for local development, and add the same variable to EAS
# (eas env:create) so builds and the website use it.
#
# Public address of the Cloudflare R2 bucket "coptic-psalmody-audio" that holds the recordings
# (the files in assets/audio, uploaded to the bucket root). No trailing slash.
# The bucket is served from the custom domain below, which is also set in the EAS production and preview environments.
# Leave it empty to use the built-in default, the bucket's r2.dev address https://pub-60c0221d60934edd82ad462615afdbf6.r2.dev
EXPO_PUBLIC_AUDIO_BASE_URL=https://audio.copticpsalmody.com
